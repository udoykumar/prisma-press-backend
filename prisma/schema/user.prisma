model user {
    id           String       @id @default(uuid())
    name         String
    email        String       @unique
    password     String
    activestatus Activestatus @default(ACTIVE)
    role         Role         @default(USER)
    createdAt    DateTime     @default(now())
    updateAt     DateTime     @updatedAt
    profile      Profile?

    comment      Comment[]
    post         Post[]
    subscription Subscription?

    @@map("Users")
}
