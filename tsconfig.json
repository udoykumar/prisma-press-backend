{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "types": ["node"],

    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true

    // "esModuleInterop": true,
    // "allowSyntheticDefaultImports": true
  },

  // "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
